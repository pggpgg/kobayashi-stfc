/target

# Node dependencies (run npm install in frontend/ after clone)
node_modules/

# Vite build output (hashed chunks); index.html may remain tracked for deploy snapshots
frontend/dist/assets/

# Fetched upstream (scripts/fetch_stfc_data.ps1) — ignore generated subdirs, not the whole folder
data/upstream/stfccommunity-data/
# Generated mapping backlog (node scripts/import_stfcspace_research.mjs --dump-unmapped)
data/research/unmapped_buff_backlog.json
# Retired LCARS monolith: now built in-process from officers.canonical.json. `generate_lcars`
# still writes this for debug/inspection only — keep it out of git so it can't drift back in.
data/officers/officers.lcars.yaml
**/.DS_Store

# Downloaded spreadsheets (e.g. Syndicate Progression)
data/import/*.xlsx

# Python cache
**/__pycache__/

# Local reference spreadsheets in repo root
Copy of STFC Cheat Sheet - M86 (1.4RC).xlsx

# Env files (secrets)
.env
.env.local

# Simulator benchmark log (periodic runs)
benchmark_log.csv

# LCARS coverage report (cargo run --bin validate_data -- --coverage)
/docs/lcars_coverage_report.json
/docs/lcars_coverage_report.md

# Sync ingress log (append-only when POST /api/sync/ingress is received)
sync.log

# User profiles (keep only demo for repo). index.json holds sync tokens — never commit.
profiles/*
!profiles/README.md
!profiles/index.json.example
!profiles/demo/
!profiles/demo/**

# Playwright artifacts
playwright-report/
test-results/

# Test coverage (CI artifacts; informational only)
coverage/
frontend/coverage/
rust-lcov.info
